---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  /** Pin the page to one theme and hide the toggle. For pages whose own
      palette or canvas only works in one of them. */
  theme?: 'dark' | 'light';
}

const {
  title = 'potnuse',
  description,
  image = '/og-default.png',
  type,
  theme,
} = Astro.props;

const SITE = 'https://rdmontgomery.com';
const canonical = new URL(Astro.url.pathname, SITE).toString();
const ogImage = new URL(image, SITE).toString();
const ogType = type ?? (Astro.url.pathname === '/' ? 'website' : 'article');
const ogDesc =
  description ?? 'a garden with the workshop door left ajar';
const displayTitle =
  title === 'potnuse' ? 'rdmontgomery.com' : `${title} — rdmontgomery.com`;
---

<!doctype html>
<html lang="en" data-theme={theme} data-theme-pinned={theme ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Runs before first paint so a light-mode reader never sees a dark
      // flash. An explicit choice wins; otherwise follow the system.
      (function () {
        var root = document.documentElement;
        if (root.hasAttribute('data-theme-pinned')) return;
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var mq = window.matchMedia('(prefers-color-scheme: light)');
        root.dataset.theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : mq.matches
              ? 'light'
              : 'dark';
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>

    <meta property="og:site_name" content="rdmontgomery.com" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400..900;1,400..900&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=STIX+Two+Text:ital,wght@0,400;0,500;1,400&display=swap"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/JetBrainsMono-VariableFont.woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />

    {
      !theme && (
        <button
          type="button"
          class="theme-toggle"
          aria-label="switch colour theme"
          title="switch colour theme"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.25" />
            <path d="M8 1.75 A6.25 6.25 0 0 1 8 14.25 Z" fill="currentColor" />
          </svg>
        </button>
      )
    }

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector('.theme-toggle');
      if (toggle) {
        toggle.addEventListener('click', () => {
          const next = root.dataset.theme === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
        });
        // Until the reader picks, track the system as it changes.
        window
          .matchMedia('(prefers-color-scheme: light)')
          .addEventListener('change', (ev) => {
            let stored = null;
            try {
              stored = localStorage.getItem('theme');
            } catch {}
            if (!stored) root.dataset.theme = ev.matches ? 'light' : 'dark';
          });
      }
    </script>

    <script>
      // Up Down Left Right Left Right — opens /rhizome from anywhere.
      // No repeated directions, so the mobile gesture is just six clean
      // direction changes in one continuous drag.

      /** @type {Array<'U'|'D'|'L'|'R'>} */
      const SEQUENCE = ['U', 'D', 'L', 'R', 'L', 'R'];
      const DEBUG =
        new URLSearchParams(window.location.search).get('konami') === 'debug';
      const log = (...args) => {
        if (DEBUG) console.log('[konami]', ...args);
      };
      if (DEBUG) log('debug on; sequence', SEQUENCE.join(''));
      const KEY_TO_DIR = {
        ArrowUp: 'U',
        ArrowDown: 'D',
        ArrowLeft: 'L',
        ArrowRight: 'R',
      };

      function enter() {
        window.location.href = '/rhizome';
      }

      // --- keyboard ---
      let keyPos = 0;
      window.addEventListener('keydown', (ev) => {
        const target = ev.target;
        if (
          target instanceof HTMLElement &&
          (target.isContentEditable ||
            target.tagName === 'INPUT' ||
            target.tagName === 'TEXTAREA')
        ) {
          return;
        }
        const dir = KEY_TO_DIR[ev.key];
        if (!dir) {
          keyPos = 0;
          return;
        }
        keyPos =
          dir === SEQUENCE[keyPos]
            ? keyPos + 1
            : dir === SEQUENCE[0]
              ? 1
              : 0;
        if (keyPos === SEQUENCE.length) {
          keyPos = 0;
          enter();
        }
      });

      // --- touch: one continuous drag with six direction changes ---
      const MIN_LEG = 28; // px in the dominant axis before a leg counts
      /** @type {Array<'U'|'D'|'L'|'R'>} */
      let legs = [];
      let anchorX = 0;
      let anchorY = 0;
      let tracking = false;
      let currentDir = null;

      function matchesSoFar() {
        if (legs.length > SEQUENCE.length) return false;
        for (let i = 0; i < legs.length; i++) {
          if (legs[i] !== SEQUENCE[i]) return false;
        }
        return true;
      }

      window.addEventListener(
        'touchstart',
        (ev) => {
          if (ev.touches.length !== 1) {
            tracking = false;
            legs = [];
            return;
          }
          const t = ev.touches[0];
          tracking = true;
          legs = [];
          currentDir = null;
          anchorX = t.clientX;
          anchorY = t.clientY;
          log('touchstart', { x: t.clientX, y: t.clientY });
        },
        { passive: true },
      );

      window.addEventListener(
        'touchmove',
        (ev) => {
          if (!tracking || ev.touches.length !== 1) return;
          const t = ev.touches[0];
          const dx = t.clientX - anchorX;
          const dy = t.clientY - anchorY;
          const adx = Math.abs(dx);
          const ady = Math.abs(dy);
          const dominant = adx > ady ? adx : ady;
          if (dominant < MIN_LEG) return;

          const dir =
            adx > ady ? (dx > 0 ? 'R' : 'L') : dy > 0 ? 'D' : 'U';

          if (dir !== currentDir) {
            legs.push(dir);
            currentDir = dir;
            log('leg', legs.length, dir, 'path:', legs.join(''), {
              expected: SEQUENCE[legs.length - 1],
              ok: matchesSoFar(),
            });
            if (!matchesSoFar()) {
              tracking = false;
              legs = [];
              log('mismatch, abort');
              return;
            }
          }
          anchorX = t.clientX;
          anchorY = t.clientY;

          if (legs.length >= 2 && ev.cancelable) {
            ev.preventDefault();
          }
        },
        { passive: false },
      );

      window.addEventListener('touchend', () => {
        log('touchend', { legs: legs.join(''), tracking });
        if (tracking && legs.length === SEQUENCE.length && matchesSoFar()) {
          legs = [];
          tracking = false;
          log('MATCH, navigating');
          enter();
          return;
        }
        tracking = false;
        legs = [];
      });

      window.addEventListener('touchcancel', () => {
        tracking = false;
        legs = [];
      });
    </script>

    <style is:global>
      /* Self-hosted variable font — Google's CDN ships a Latin-only subset
         that drops the U+2500 Box Drawing block and U+2580 Block Elements,
         which the care-for-an-esper masthead and dialog boxes rely on. */
      @font-face {
        font-family: 'JetBrains Mono';
        font-style: normal;
        font-display: swap;
        font-weight: 100 800;
        src: url('/fonts/JetBrainsMono-VariableFont.woff2')
          format('woff2-variations');
      }

      :root {
        --font-crimson: 'Crimson Pro', Georgia, 'Iowan Old Style', serif;
        --font-jetbrains: 'JetBrains Mono', ui-monospace, 'SF Mono', monospace;
        color-scheme: dark;
        /* Every colour here shares one amber hue, so luminance is the only
           channel separating them. Text tokens hold WCAG AA (4.5:1) against
           --bg-card; check new ones before adding them. */
        --bg: #1a1207;
        --bg-card: #261d0f;
        --bg-button: #332814;
        --accent: #e8a838;
        --accent-dim: #b87a1e;
        --text: #f0e6d2;
        --text-dim: #aea189;
        --text-muted: #968365;
        --border: #3d2e1a;
        --rule: rgba(240, 230, 210, 0.1);
        --rule-strong: rgba(240, 230, 210, 0.18);
        --underline: rgba(232, 168, 56, 0.5);
        --underline-dim: rgba(158, 142, 114, 0.6);
        --shadow: rgba(0, 0, 0, 0.45);
        --glow: #f0e6d2;
        --danger: #c87060;
        --danger-bg: #6b3a30;
        --danger-ink: #f0d6cc;
        /* collection marks: sigil, backlinks, rhizome */
        --c-essays: #e8a838;
        --c-experiments: #7fb069;
        --c-exchanges: #c48ac9;
        --c-page: #9e8e72;
        /* figure series */
        --viz-amber: #c98500;
        --viz-rose: #d55181;
        --viz-blue: #3987e5;
      }
      :root[data-theme='light'] {
        color-scheme: light;
        --bg: #f5eedf;
        --bg-card: #ece2cc;
        --bg-button: #e2d5b8;
        --accent: #8f5600;
        --accent-dim: #7f5b22;
        --text: #241a0c;
        --text-dim: #5c4c33;
        --text-muted: #6e5e44;
        --border: #d3c29e;
        --rule: rgba(36, 26, 12, 0.12);
        --rule-strong: rgba(36, 26, 12, 0.22);
        --underline: rgba(143, 86, 0, 0.45);
        --underline-dim: rgba(92, 76, 51, 0.5);
        --shadow: rgba(60, 40, 10, 0.18);
        /* dark ink can't glow on paper; freshness reads as warm light */
        --glow: #e8a838;
        --danger: #a8452f;
        --danger-bg: #f0d0c4;
        --danger-ink: #5a2418;
        --c-essays: #9a6200;
        --c-experiments: #4c7a33;
        --c-exchanges: #8a4a92;
        --c-page: #7d6c50;
        --viz-amber: #946000;
        --viz-rose: #b8325f;
        --viz-blue: #1f68c4;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-crimson);
        font-size: 18px;
        line-height: 1.55;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      ::selection {
        background: var(--accent);
        color: var(--bg);
      }
      .theme-toggle {
        position: fixed;
        top: 0.9rem;
        right: 0.9rem;
        z-index: 50;
        width: 2rem;
        height: 2rem;
        display: grid;
        place-items: center;
        padding: 0;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--bg);
        color: var(--text-muted);
        cursor: pointer;
        opacity: 0.7;
        transition:
          opacity 0.15s ease,
          color 0.15s ease;
      }
      .theme-toggle:hover,
      .theme-toggle:focus-visible {
        opacity: 1;
        color: var(--accent);
      }
      .theme-toggle svg {
        width: 1rem;
        height: 1rem;
      }
      @media print {
        .theme-toggle {
          display: none;
        }
      }
    </style>
  </body>
</html>
