---
import '@/styles/themes.css';
import { AUTO, THEMES, type ThemeName } from '@/lib/themes';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  /** Pin the page to one theme and hide the picker. For pages whose own
      palette lives in JS or canvas and only matches that one. */
  theme?: ThemeName;
}

const {
  title = 'potnuse',
  description,
  image = '/og-default.png',
  type,
  theme,
} = Astro.props;

const SITE = 'https://rdmontgomery.com';
const canonical = new URL(Astro.url.pathname, SITE).toString();
const ogImage = new URL(image, SITE).toString();
const ogType = type ?? (Astro.url.pathname === '/' ? 'website' : 'article');
const ogDesc =
  description ?? 'a garden with the workshop door left ajar';
const themeNames = THEMES.map((t) => t.name);
const displayTitle =
  title === 'potnuse' ? 'rdmontgomery.com' : `${title} — rdmontgomery.com`;
---

<!doctype html>
<html lang="en" data-theme={theme} data-theme-pinned={theme ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <script is:inline define:vars={{ themeNames, AUTO }}>
      // Runs before first paint so nobody sees the wrong palette flash.
      // A stored pick wins; "auto" (or nothing) follows the system.
      var root = document.documentElement;
      if (!root.hasAttribute('data-theme-pinned')) {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        root.dataset.theme =
          themeNames.indexOf(stored) >= 0
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? AUTO.light
              : AUTO.dark;
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>

    <meta property="og:site_name" content="rdmontgomery.com" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400..900;1,400..900&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=STIX+Two+Text:ital,wght@0,400;0,500;1,400&display=swap"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/JetBrainsMono-VariableFont.woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />

    {
      !theme && (
        <>
          <button
            type="button"
            class="theme-toggle"
            popovertarget="theme-menu"
            aria-label="colour theme"
            title="colour theme"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.25" />
              <path d="M8 1.75 A6.25 6.25 0 0 1 8 14.25 Z" fill="currentColor" />
            </svg>
          </button>
          <div id="theme-menu" class="theme-menu" popover aria-label="colour theme">
            <button type="button" data-pick="auto" aria-pressed="false">
              <span class="swatch auto" aria-hidden="true">
                <span data-theme={AUTO.dark} />
                <span data-theme={AUTO.light} />
              </span>
              auto
            </button>
            {THEMES.map((t) => (
              <button type="button" data-pick={t.name} aria-pressed="false">
                <span class="swatch" data-theme={t.name} aria-hidden="true" />
                {t.name}
              </button>
            ))}
          </div>
        </>
      )
    }

    <script>
      import { AUTO } from '@/lib/themes';

      const root = document.documentElement;
      const menu = document.getElementById('theme-menu');
      const light = window.matchMedia('(prefers-color-scheme: light)');

      const stored = () => {
        try {
          return localStorage.getItem('theme');
        } catch {
          return null;
        }
      };
      const systemTheme = () => (light.matches ? AUTO.light : AUTO.dark);

      function mark() {
        const pick = stored() ?? 'auto';
        menu?.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => {
          const on = b.dataset.pick === pick;
          b.setAttribute('aria-pressed', String(on));
        });
      }

      if (menu) {
        mark();
        menu.addEventListener('click', (ev) => {
          const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-pick]');
          if (!btn) return;
          const pick = btn.dataset.pick!;
          try {
            if (pick === 'auto') localStorage.removeItem('theme');
            else localStorage.setItem('theme', pick);
          } catch {}
          root.dataset.theme = pick === 'auto' ? systemTheme() : pick;
          mark();
          menu.hidePopover();
        });
        // On auto, track the system as it changes.
        light.addEventListener('change', () => {
          if (!stored()) root.dataset.theme = systemTheme();
        });
      }
    </script>

    <script>
      // Up Down Left Right Left Right — opens /rhizome from anywhere.
      // No repeated directions, so the mobile gesture is just six clean
      // direction changes in one continuous drag.

      /** @type {Array<'U'|'D'|'L'|'R'>} */
      const SEQUENCE = ['U', 'D', 'L', 'R', 'L', 'R'];
      const DEBUG =
        new URLSearchParams(window.location.search).get('konami') === 'debug';
      const log = (...args) => {
        if (DEBUG) console.log('[konami]', ...args);
      };
      if (DEBUG) log('debug on; sequence', SEQUENCE.join(''));
      const KEY_TO_DIR = {
        ArrowUp: 'U',
        ArrowDown: 'D',
        ArrowLeft: 'L',
        ArrowRight: 'R',
      };

      function enter() {
        window.location.href = '/rhizome';
      }

      // --- keyboard ---
      let keyPos = 0;
      window.addEventListener('keydown', (ev) => {
        const target = ev.target;
        if (
          target instanceof HTMLElement &&
          (target.isContentEditable ||
            target.tagName === 'INPUT' ||
            target.tagName === 'TEXTAREA')
        ) {
          return;
        }
        const dir = KEY_TO_DIR[ev.key];
        if (!dir) {
          keyPos = 0;
          return;
        }
        keyPos =
          dir === SEQUENCE[keyPos]
            ? keyPos + 1
            : dir === SEQUENCE[0]
              ? 1
              : 0;
        if (keyPos === SEQUENCE.length) {
          keyPos = 0;
          enter();
        }
      });

      // --- touch: one continuous drag with six direction changes ---
      const MIN_LEG = 28; // px in the dominant axis before a leg counts
      /** @type {Array<'U'|'D'|'L'|'R'>} */
      let legs = [];
      let anchorX = 0;
      let anchorY = 0;
      let tracking = false;
      let currentDir = null;

      function matchesSoFar() {
        if (legs.length > SEQUENCE.length) return false;
        for (let i = 0; i < legs.length; i++) {
          if (legs[i] !== SEQUENCE[i]) return false;
        }
        return true;
      }

      window.addEventListener(
        'touchstart',
        (ev) => {
          if (ev.touches.length !== 1) {
            tracking = false;
            legs = [];
            return;
          }
          const t = ev.touches[0];
          tracking = true;
          legs = [];
          currentDir = null;
          anchorX = t.clientX;
          anchorY = t.clientY;
          log('touchstart', { x: t.clientX, y: t.clientY });
        },
        { passive: true },
      );

      window.addEventListener(
        'touchmove',
        (ev) => {
          if (!tracking || ev.touches.length !== 1) return;
          const t = ev.touches[0];
          const dx = t.clientX - anchorX;
          const dy = t.clientY - anchorY;
          const adx = Math.abs(dx);
          const ady = Math.abs(dy);
          const dominant = adx > ady ? adx : ady;
          if (dominant < MIN_LEG) return;

          const dir =
            adx > ady ? (dx > 0 ? 'R' : 'L') : dy > 0 ? 'D' : 'U';

          if (dir !== currentDir) {
            legs.push(dir);
            currentDir = dir;
            log('leg', legs.length, dir, 'path:', legs.join(''), {
              expected: SEQUENCE[legs.length - 1],
              ok: matchesSoFar(),
            });
            if (!matchesSoFar()) {
              tracking = false;
              legs = [];
              log('mismatch, abort');
              return;
            }
          }
          anchorX = t.clientX;
          anchorY = t.clientY;

          if (legs.length >= 2 && ev.cancelable) {
            ev.preventDefault();
          }
        },
        { passive: false },
      );

      window.addEventListener('touchend', () => {
        log('touchend', { legs: legs.join(''), tracking });
        if (tracking && legs.length === SEQUENCE.length && matchesSoFar()) {
          legs = [];
          tracking = false;
          log('MATCH, navigating');
          enter();
          return;
        }
        tracking = false;
        legs = [];
      });

      window.addEventListener('touchcancel', () => {
        tracking = false;
        legs = [];
      });
    </script>

    <style is:global>
      /* Self-hosted variable font — Google's CDN ships a Latin-only subset
         that drops the U+2500 Box Drawing block and U+2580 Block Elements,
         which the care-for-an-esper masthead and dialog boxes rely on. */
      @font-face {
        font-family: 'JetBrains Mono';
        font-style: normal;
        font-display: swap;
        font-weight: 100 800;
        src: url('/fonts/JetBrainsMono-VariableFont.woff2')
          format('woff2-variations');
      }

      :root {
        --font-crimson: 'Crimson Pro', Georgia, 'Iowan Old Style', serif;
        --font-jetbrains: 'JetBrains Mono', ui-monospace, 'SF Mono', monospace;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-crimson);
        font-size: 18px;
        line-height: 1.55;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      ::selection {
        background: var(--accent);
        color: var(--bg);
      }
      .theme-toggle {
        position: fixed;
        top: 0.9rem;
        right: 0.9rem;
        z-index: 50;
        width: 2rem;
        height: 2rem;
        display: grid;
        place-items: center;
        padding: 0;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--bg);
        color: var(--text-muted);
        cursor: pointer;
        opacity: 0.7;
        transition:
          opacity 0.15s ease,
          color 0.15s ease;
      }
      .theme-toggle:hover,
      .theme-toggle:focus-visible {
        opacity: 1;
        color: var(--accent);
      }
      .theme-toggle svg {
        width: 1rem;
        height: 1rem;
      }
      .theme-menu {
        position: fixed;
        inset: 3.3rem 0.9rem auto auto;
        margin: 0;
        padding: 0.35rem;
        min-width: 10.5rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--bg-card);
        color: var(--text-dim);
        box-shadow: 0 8px 24px var(--shadow);
        font-family: var(--font-jetbrains);
        font-size: 0.72rem;
        letter-spacing: 0.04em;
      }
      .theme-menu button {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        width: 100%;
        padding: 0.4rem 0.55rem;
        border: 0;
        border-radius: 4px;
        background: none;
        color: inherit;
        font: inherit;
        letter-spacing: inherit;
        text-align: left;
        cursor: pointer;
      }
      .theme-menu button:hover,
      .theme-menu button:focus-visible {
        background: var(--bg-button);
        color: var(--text);
        outline: none;
      }
      .theme-menu button[aria-pressed='true'] {
        color: var(--accent);
      }
      .theme-menu button[data-pick='auto'] {
        margin-bottom: 0.2rem;
        border-bottom: 1px solid var(--border);
        border-radius: 4px 4px 0 0;
      }
      /* each swatch wears its own palette: ground, with an accent dot */
      .swatch {
        flex: none;
        width: 1rem;
        height: 1rem;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: radial-gradient(
          circle,
          var(--accent) 0 28%,
          var(--bg) 32%
        );
      }
      .swatch.auto {
        display: flex;
        overflow: hidden;
        background: none;
      }
      .swatch.auto > span {
        flex: 1;
        background: var(--bg);
      }
      @media print {
        .theme-toggle,
        .theme-menu {
          display: none;
        }
      }
    </style>
  </body>
</html>
