---
// Reading order for the calibration posts, shown at the top of each.
// Two numbered posts, plus a physicist's-intuition post for readers who want the why.
interface Props {
  current: 1 | 2 | 'intuition';
}
const { current } = Astro.props;
const parts = [
  { n: 1, label: '1. decisions', href: '/experiments/what-jev-is-selling' },
  { n: 2, label: '2. production', href: '/experiments/probability-you-can-count-on' },
  { n: 'intuition', label: "a physicist's intuition", href: '/experiments/confidence-has-a-temperature' },
];
---

<nav class="series" aria-label="series">
  {
    parts.map((p, i) => (
      <>
        {i > 0 && <span class="dot">·</span>}
        {p.n === current ? (
          <span class="here" aria-current="page">{p.label}</span>
        ) : (
          <a href={p.href}>{p.label}</a>
        )}
      </>
    ))
  }
</nav>

<style>
  .series {
    font-family: var(--font-jetbrains);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin: 0 0 2.2rem;
  }
  .series a {
    color: var(--text-dim);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }
  .series a:hover {
    color: var(--accent);
  }
  .series .here {
    color: var(--accent);
  }
  .series .dot {
    margin: 0 0.6em;
  }
</style>
