---
import { getBacklinks, getForwardLinks, getNode } from '@/lib/graph';
import { SIGIL_COLORS } from '@/lib/sigil';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const [back, forward, self] = await Promise.all([
  getBacklinks(slug),
  getForwardLinks(slug),
  getNode(slug),
]);
const hasAnything = back.length > 0 || forward.length > 0;

// Newest first on both sides, so vertical position carries the same meaning
// it does everywhere else on the site: higher is more recent.
const byDate = (a: { date?: string }, b: { date?: string }) =>
  Date.parse(b.date ?? '0') - Date.parse(a.date ?? '0');
const out = [...forward].sort(byDate);
const inbound = [...back].sort(byDate);
const color = (c: string) => SIGIL_COLORS[c] ?? SIGIL_COLORS.page;
const when = (d?: string) => (d ? d.slice(0, 7) : '');
---

{
  hasAnything && (
    <nav class="pressure" aria-label="graph neighbors">
      <div
        class:list={[
          'ego',
          { 'has-in': inbound.length > 0, 'has-out': out.length > 0 },
        ]}
      >
        <svg class="threads" aria-hidden="true" />

        <div class="col in">
          {inbound.length > 0 && <h2>pointed to by</h2>}
          <ul>
            {inbound.map((n) => (
              <li>
                <a class="thread" href={n.url} data-color={color(n.collection)}>
                  <span class="dot" style={`--c: ${color(n.collection)}`} data-state={n.state} />
                  <span class="label">
                    <span class="title">{n.title}</span>
                    <span class="when">{when(n.date)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="hub">
          <span
            class="hub-dot"
            style={`--c: ${color(self?.collection ?? 'page')}`}
          />
          <span class="hub-title">{self?.title ?? slug}</span>
        </div>

        <div class="col out">
          {out.length > 0 && <h2>connects to</h2>}
          <ul>
            {out.map((n) => (
              <li>
                <a class="thread" href={n.url} data-color={color(n.collection)}>
                  <span class="dot" style={`--c: ${color(n.collection)}`} data-state={n.state} />
                  <span class="label">
                    <span class="title">{n.title}</span>
                    <span class="when">{when(n.date)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </nav>
  )
}

<script>
  // The threads are drawn after layout rather than computed at build: the dots
  // sit wherever the text flows them, and text flow depends on the viewport.
  // Links and labels are ordinary HTML, so this layer is decorative — with no
  // JS you get the two columns and lose only the curves.
  function wire(root: HTMLElement) {
    const svg = root.querySelector('.threads') as SVGSVGElement | null;
    const hubDot = root.querySelector('.hub-dot') as HTMLElement | null;
    if (!svg || !hubDot) return;

    const draw = () => {
      const box = root.getBoundingClientRect();
      if (box.width === 0) return;
      svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
      svg.setAttribute('width', String(box.width));
      svg.setAttribute('height', String(box.height));

      const hub = hubDot.getBoundingClientRect();
      const hx = hub.left + hub.width / 2 - box.left;
      const hy = hub.top + hub.height / 2 - box.top;

      const paths: string[] = [];
      for (const link of root.querySelectorAll<HTMLElement>('.thread')) {
        const dot = link.querySelector('.dot');
        if (!dot) continue;
        const d = dot.getBoundingClientRect();
        const x = d.left + d.width / 2 - box.left;
        const y = d.top + d.height / 2 - box.top;
        // Two control points on a horizontal tangent: the thread leaves the
        // hub sideways and arrives sideways, so it reads as a root rather
        // than a ruled line, and stacked neighbours never overlap.
        const mid = (hx + x) / 2;
        paths.push(
          `<path d="M ${hx} ${hy} C ${mid} ${hy}, ${mid} ${y}, ${x} ${y}" fill="none" stroke="${link.dataset.color}" stroke-width="1" opacity="0.32" />`,
        );
      }
      svg.innerHTML = paths.join('');
    };

    draw();
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(draw).observe(root);
    } else {
      window.addEventListener('resize', draw);
    }
    if (document.fonts?.ready) document.fonts.ready.then(draw);
  }

  for (const el of document.querySelectorAll<HTMLElement>('.ego')) wire(el);
</script>

<style>
  .pressure {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(240, 230, 210, 0.1);
  }
  .ego {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.5rem 2rem;
    justify-content: center;
  }
  /* With one side empty, drop its column so the hub and its neighbours centre
     as a unit instead of leaving a hole where the missing side would be. */
  .ego:not(.has-in) {
    grid-template-columns: auto minmax(0, max-content);
  }
  .ego:not(.has-in) .col.in,
  .ego:not(.has-out) .col.out {
    display: none;
  }
  .ego:not(.has-out) {
    grid-template-columns: minmax(0, max-content) auto;
  }
  .col {
    align-self: start;
    min-width: 0;
  }
  .hub {
    align-self: center;
  }
  .threads {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .col,
  .hub {
    position: relative;
    z-index: 1;
  }
  .label {
    max-width: 22rem;
  }
  .col.in {
    text-align: right;
  }
  h2 {
    font-size: 0.65rem;
    font-family: var(--font-jetbrains), ui-monospace, monospace;
    text-transform: lowercase;
    letter-spacing: 0.12em;
    color: var(--text-muted, #6b5d48);
    margin: 0 0 0.9rem;
    font-weight: 400;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .thread {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--text, #f0e6d2);
  }
  .in .thread {
    flex-direction: row-reverse;
  }
  .dot {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c);
    opacity: 0.9;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .dot[data-state='fossil'] {
    opacity: 0.45;
  }
  .dot[data-state='seedling'] {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 18%, transparent);
  }
  .label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    border-bottom: 1px solid rgba(240, 230, 210, 0.18);
    transition: border-color 0.15s ease;
  }
  .in .label {
    flex-direction: row-reverse;
  }
  .thread:hover .label {
    border-bottom-color: var(--accent, #e8a838);
  }
  .thread:hover .dot {
    transform: scale(1.35);
  }
  .when {
    font-family: var(--font-jetbrains), ui-monospace, monospace;
    font-size: 0.65rem;
    color: var(--text-muted, #6b5d48);
    white-space: nowrap;
  }
  .hub {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.5rem;
  }
  .hub-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--c) 14%, transparent);
  }
  .hub-title {
    font-family: var(--font-jetbrains), ui-monospace, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--text-muted, #6b5d48);
    max-width: 8rem;
    text-align: center;
    /* The threads pass under the hub, so the label needs to sit on the page
       colour or the curves read straight through the type. */
    background: var(--bg, #1a1410);
    padding: 0.15rem 0.35rem;
  }
  @media (max-width: 640px) {
    .ego,
    .ego:not(.has-in),
    .ego:not(.has-out) {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      justify-items: start;
    }
    .label {
      max-width: none;
    }
    .threads {
      display: none;
    }
    .col.in {
      text-align: left;
    }
    .in .thread {
      flex-direction: row;
    }
    .in .label {
      flex-direction: row;
    }
    .hub {
      flex-direction: row;
      align-items: center;
      padding: 0;
    }
    .hub-title {
      max-width: none;
      text-align: left;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot,
    .label {
      transition: none;
    }
  }
</style>
