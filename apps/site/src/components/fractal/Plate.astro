---
// A figure plate for the experiment results: an image generated by the
// research code under /research/fractal-electrode, with a monospace caption
// matching the diagram components.
interface Props {
  src: string;
  alt: string;
}
const { src, alt } = Astro.props;
---

<figure class="plate">
  <img src={src} alt={alt} loading="lazy" />
  <figcaption><slot /></figcaption>
</figure>

<style>
  .plate {
    margin: 2.4em 0;
  }
  .plate img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #1a1207;
  }
  figcaption {
    font-family: var(--font-jetbrains);
    font-size: 0.72rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin-top: 0.8rem;
    letter-spacing: 0.01em;
    max-width: 60ch;
  }
</style>
