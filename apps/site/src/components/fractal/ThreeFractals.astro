---
// Three fractals, three dimensions. Left: a diffusion-limited aggregate
// (how electrodeposited metal and growth-cone-guided dendrites both actually
// grow), D approx 1.71. Middle: the H-tree Rick drew, D heading to 2.
// Right: a real dendritic arbor, the optimum the biology lands on, D approx 1.4.
// The DLA and the dendrite are built deterministically at build time.

// --- seeded RNG ---
function mulberry32(a: number) {
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// --- DLA on a lattice ---
function growDLA(seed: number, particles: number, grid: number) {
  const rnd = mulberry32(seed);
  const occ = new Set<string>();
  const c = grid >> 1;
  occ.add(`${c},${c}`);
  let maxR = 1;
  const pts: [number, number][] = [[c, c]];
  const key = (x: number, y: number) => `${x},${y}`;
  const stuckNear = (x: number, y: number) =>
    occ.has(key(x + 1, y)) || occ.has(key(x - 1, y)) || occ.has(key(x, y + 1)) || occ.has(key(x, y - 1));
  for (let p = 0; p < particles; p++) {
    const spawnR = Math.min(maxR + 4, c - 2);
    const a = rnd() * Math.PI * 2;
    let x = Math.round(c + spawnR * Math.cos(a));
    let y = Math.round(c + spawnR * Math.sin(a));
    const killR = spawnR + 8;
    let steps = 0;
    while (steps++ < 4000) {
      if (stuckNear(x, y)) {
        occ.add(key(x, y));
        pts.push([x, y]);
        maxR = Math.max(maxR, Math.hypot(x - c, y - c));
        break;
      }
      const d = (rnd() * 4) | 0;
      if (d === 0) x++;
      else if (d === 1) x--;
      else if (d === 2) y++;
      else y--;
      if (Math.hypot(x - c, y - c) > killR) {
        // respawn on the ring
        const a2 = rnd() * Math.PI * 2;
        x = Math.round(c + spawnR * Math.cos(a2));
        y = Math.round(c + spawnR * Math.sin(a2));
      }
    }
  }
  return { pts, c, maxR };
}

const grid = 121;
const { pts, c } = growDLA(20140531, 1400, grid);
const VB = 150;
const sc = VB / grid;

// --- a stylized dendrite (sparse, branching, D ~ 1.4) ---
type L = { x1: number; y1: number; x2: number; y2: number; w: number };
function dendrite(seed: number) {
  const rnd = mulberry32(seed);
  const lines: L[] = [];
  function branch(x: number, y: number, ang: number, len: number, w: number, depth: number) {
    if (depth > 7 || len < 3) return;
    const x2 = x + Math.cos(ang) * len;
    const y2 = y + Math.sin(ang) * len;
    lines.push({ x1: x, y1: y, x2, y2, w });
    const n = 2 + (rnd() < 0.35 ? 1 : 0);
    for (let i = 0; i < n; i++) {
      const spread = 0.5 + rnd() * 0.7;
      const da = (i - (n - 1) / 2) * spread + (rnd() - 0.5) * 0.4;
      branch(x2, y2, ang + da, len * (0.68 + rnd() * 0.16), Math.max(0.5, w * 0.7), depth + 1);
    }
  }
  // soma at center, a few primary dendrites radiating out
  const prim = 5;
  for (let i = 0; i < prim; i++) {
    const a = (i / prim) * Math.PI * 2 + rnd() * 0.5;
    branch(VB / 2, VB / 2, a, 26, 2.4, 0);
  }
  return lines;
}
const den = dendrite(7);

// --- H-tree for the middle panel ---
type Seg = { x1: number; y1: number; x2: number; y2: number; d: number };
function htree(x: number, y: number, len: number, depth: number, horiz: boolean, max: number, out: Seg[]) {
  if (depth > max) return;
  if (horiz) {
    const xa = x - len / 2, xb = x + len / 2;
    out.push({ x1: xa, y1: y, x2: xb, y2: y, d: depth });
    const n = len / Math.SQRT2;
    htree(xa, y, n, depth + 1, false, max, out);
    htree(xb, y, n, depth + 1, false, max, out);
  } else {
    const ya = y - len / 2, yb = y + len / 2;
    out.push({ x1: x, y1: ya, x2: x, y2: yb, d: depth });
    const n = len / Math.SQRT2;
    htree(x, ya, n, depth + 1, true, max, out);
    htree(x, yb, n, depth + 1, true, max, out);
  }
}
const hseg: Seg[] = [];
htree(VB / 2, VB / 2, VB * 0.46, 1, true, 4, hseg);
---

<figure class="fig">
  <div class="row">
    <div class="cell">
      <svg viewBox={`0 0 ${VB} ${VB}`} role="img" aria-label="diffusion-limited aggregate">
        {pts.map(([x, y]) => (
          <rect x={(x - 0.5) * sc} y={(y - 0.5) * sc} width={sc * 1.15} height={sc * 1.15} fill="var(--accent)" />
        ))}
      </svg>
      <span class="cap">diffusion-limited aggregate</span>
      <span class="dim">D &asymp; 1.71</span>
      <span class="note">how metal <em>plates</em> and how dendrites <em>grow</em></span>
    </div>

    <div class="cell">
      <svg viewBox={`0 0 ${VB} ${VB}`} role="img" aria-label="H-tree">
        {hseg.map((s) => (
          <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke="var(--accent)" stroke-width={Math.max(0.6, 2.4 - s.d * 0.4)} stroke-linecap="round" />
        ))}
      </svg>
      <span class="cap">the H-tree you drew</span>
      <span class="dim">D &rarr; 2</span>
      <span class="note">deterministic, manufacturable, space-filling</span>
    </div>

    <div class="cell">
      <svg viewBox={`0 0 ${VB} ${VB}`} role="img" aria-label="dendritic arbor">
        {den.map((l) => (
          <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="var(--text-dim)" stroke-width={l.w} stroke-linecap="round" />
        ))}
        <circle cx={VB / 2} cy={VB / 2} r="4.5" fill="var(--accent-dim)" />
      </svg>
      <span class="cap">a real dendrite</span>
      <span class="dim">D &asymp; 1.4</span>
      <span class="note">the optimum biology actually picks</span>
    </div>
  </div>
  <figcaption>
    You built the middle one. The biology is the right one. And the left one is the process that
    grows <em>both</em> the plated metal and the neuron &mdash; the shared parent neither literature put on the page.
  </figcaption>
</figure>

