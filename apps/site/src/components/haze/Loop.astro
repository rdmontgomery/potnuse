    <text x="203.79" y="352" class="tick mid">10</text>
    <line x1="280.34" y1="30" x2="280.34" y2="332" class="grid" />
    <text x="280.34" y="352" class="tick mid">15</text>
    <line x1="356.9" y1="30" x2="356.9" y2="332" class="grid" />
    <text x="356.9" y="352" class="tick mid">20</text>
