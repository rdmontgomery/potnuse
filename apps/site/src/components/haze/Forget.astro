---
// Generated by packages/calibration-lab/lab/figures.py from results.json. Do not edit by hand.
interface Props { caption?: boolean }
const { caption = true } = Astro.props;
---

<figure>
  <svg class="fig" viewBox="0 0 660 380" role="img" aria-label="Calibration error over batches for four ways of running the recalibration loop.">
    <line x1="66.0" y1="30" x2="66.0" y2="332" class="grid" />
    <text x="66.0" y="352" class="tick mid">1</text>
    <line x1="150.57" y1="30" x2="150.57" y2="332" class="grid" />
    <text x="150.57" y="352" class="tick mid">5</text>
    <line x1="256.29" y1="30" x2="256.29" y2="332" class="grid" />
    <text x="256.29" y="352" class="tick mid">10</text>
    <line x1="362.0" y1="30" x2="362.0" y2="332" class="grid" />
    <text x="362.0" y="352" class="tick mid">15</text>
    <line x1="467.71" y1="30" x2="467.71" y2="332" class="grid" />
    <text x="467.71" y="352" class="tick mid">20</text>
    <line x1="66" y1="332.0" x2="510" y2="332.0" class="grid" />
    <text x="56" y="336.0" class="tick end">0.000</text>
    <line x1="66" y1="261.06" x2="510" y2="261.06" class="grid" />
    <text x="56" y="265.06" class="tick end">0.006</text>
    <line x1="66" y1="178.3" x2="510" y2="178.3" class="grid" />
    <text x="56" y="182.3" class="tick end">0.013</text>
    <line x1="66" y1="107.37" x2="510" y2="107.37" class="grid" />
    <text x="56" y="111.37" class="tick end">0.019</text>
    <line x1="66" y1="24.61" x2="510" y2="24.61" class="grid" />
    <text x="56" y="28.61" class="tick end">0.026</text>
    <line x1="66" y1="332" x2="510" y2="332" class="axis" />
    <line x1="66" y1="30" x2="66" y2="332" class="axis" />
    <text x="288.0" y="372" class="label mid">batch (150 tweets each)</text>
    <text x="14" y="181.0" class="label mid" transform="rotate(-90 14 181.0)">error vs the truth (MSE)</text>
    <rect x="224.57" y="30" width="285.43" height="302" fill="var(--viz-blue)" opacity="0.07" />
    <text x="239.14" y="42.08" class="note">the storm arrives</text>
