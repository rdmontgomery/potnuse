    <text x="56" y="134.67" class="tick end">0.1</text>
    <line x1="66" y1="30.0" x2="530" y2="30.0" class="grid" />
    <text x="56" y="34.0" class="tick end">1</text>
    <line x1="66" y1="332" x2="530" y2="332" class="axis" />
