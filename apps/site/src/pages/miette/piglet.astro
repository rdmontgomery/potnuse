---
import PigletDraw from '@/components/miette/PigletDraw';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Miette's piglet drawing game</title>
    <meta name="robots" content="noindex" />
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
        background: #fff5f8;
      }
      * {
        box-sizing: border-box;
      }
    </style>
  </head>
  <body>
    <PigletDraw client:only="react" />
  </body>
</html>
