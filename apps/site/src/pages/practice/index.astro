---
import Base from '@/layouts/Base.astro';
import PracticeRunner from '@/components/practice/PracticeRunner';
---

<Base
  title="practice"
  description="Due cards from the curriculum, each surfaced with the instrument it was learned on."
>
  <article class="practice-page">
    <header class="practice-hero">
      <p class="practice-eyebrow">practice</p>
      <h1 class="practice-title">practice, not review</h1>
      <p class="practice-sub">
        Due cards in scheduling order. Each one mounts the instrument it was
        learned on — clock, staff, Tonnetz when it gets there. No naked text.
      </p>
    </header>

    <PracticeRunner client:load />

    <p class="practice-foot">
      <a href="/curriculum">/curriculum</a>
    </p>
  </article>
</Base>

<style is:global>
  .practice-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
  }
  .practice-hero {
    margin: 0 0 2.5rem;
  }
  .practice-eyebrow {
    font-family: var(--font-jetbrains);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--accent-dim);
    margin: 0 0 0.75rem;
  }
  .practice-title {
    font-family: var(--font-crimson);
    font-weight: 500;
    font-size: clamp(2rem, 6vw, 2.8rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 1rem;
  }
  .practice-sub {
    font-family: var(--font-crimson);
    color: var(--text-dim);
    font-size: 1.05rem;
    line-height: 1.55;
    margin: 0;
  }
  .practice-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .practice-card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-jetbrains);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .practice-progress {
    color: var(--accent);
  }
  .practice-tag {
    color: var(--text-muted);
  }
  .practice-question {
    font-family: var(--font-crimson);
    font-size: 1.2rem;
    line-height: 1.45;
    margin: 0;
    color: var(--text);
  }
  .practice-hint {
    font-family: var(--font-crimson);
    font-style: italic;
    color: var(--text-dim);
    font-size: 0.92rem;
    margin: 0;
  }
  .instrument {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.85rem;
  }
  .click-on-clock-instrument svg {
    align-self: center;
  }

  .practice-status,
  .practice-empty,
  .practice-done {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.5rem;
    color: var(--text-dim);
    font-family: var(--font-crimson);
  }
  .practice-empty p,
  .practice-done p {
    margin: 0 0 0.8rem;
    line-height: 1.55;
  }
  .practice-empty p:last-child,
  .practice-done p:last-child {
    margin-bottom: 0;
  }
  .practice-empty a,
  .practice-done a,
  .practice-foot a {
    color: var(--accent);
    text-decoration: none;
  }
  .practice-empty a:hover,
  .practice-done a:hover,
  .practice-foot a:hover {
    color: var(--accent-dim);
  }
  .practice-empty-tip {
    font-style: italic;
    color: var(--text-muted) !important;
    font-size: 0.92rem;
  }
  .practice-foot {
    font-family: var(--font-jetbrains);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-muted);
    margin: 2.5rem 0 0;
  }
</style>
