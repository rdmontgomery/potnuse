---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Backlinks from '@/components/Backlinks.astro';
import StateBadge from '@/components/StateBadge.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  // Experiment slugs that have their own bespoke page file under src/pages/experiments/.
  // Keep this list in sync; the dynamic route skips them to avoid collisions.
  const bespokeExperiments = new Set<string>([
    'necromantic-circle',
    'ladder',
    'primer',
    'invisible-ink',
  ]);
  const bespokeEssays = new Set<string>(['care-for-an-esper']);
  const essays = await getCollection('essays');
  const experiments = await getCollection('experiments');
  return [
    ...essays
      .filter((entry) => !bespokeEssays.has(entry.id))
      .map((entry) => ({
        params: { collection: 'essays', slug: entry.id },
        props: { entry },
      })),
    ...experiments
      .filter((entry) => !bespokeExperiments.has(entry.id))
      .map((entry) => ({
        params: { collection: 'experiments', slug: entry.id },
        props: { entry },
      })),
  ];
};

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = entry.data.toc ? headings.filter((h) => h.depth === 3) : [];

// Reading time for long-form pieces (the ones that ask for a contents list).
// Counts prose only: code, imports, comments, markup, math and link targets
// are stripped, and each figure is charged half a minute to look at.
function readingMinutes(body: string): number {
  const figures = (body.match(/^<[A-Z][A-Za-z]* \/>$/gm) ?? []).length;
  const prose = body
    .replace(/^---[\s\S]*?---/, '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/\{\/\*[\s\S]*?\*\/\}/g, ' ')
    .replace(/^import .*$/gm, ' ')
    .replace(/\$\$[\s\S]*?\$\$/g, ' x ')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\]\([^)]*\)/g, ']')
    .replace(/[|#*_`>\-]+/g, ' ');
  const words = prose.split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 230 + figures * 0.5));
}
const minutes = entry.data.toc ? readingMinutes(entry.body ?? '') : null;
---

<Base title={entry.data.title} description={entry.data.description}>
  {
    toc.length > 0 && (
      <nav class="toc" aria-label="sections">
        {toc.map((h) => (
          <a href={`#${h.slug}`} data-toc={h.slug}>
            {h.text}
          </a>
        ))}
      </nav>
    )
  }
  <article class="essay">
    <header>
      <h1>{entry.data.title}</h1>
      <div class="meta">
        <StateBadge state={entry.data.state} />
        {entry.data.date && (
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toISOString().slice(0, 10)}
          </time>
        )}
        {minutes && <span>{minutes} min read</span>}
      </div>
      {
        entry.data.tldr && (
          <p class="tldr">
            <span class="tldr-label">tl;dr</span>
            {entry.data.tldr}
          </p>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
    <Backlinks slug={entry.id} />
  </article>
</Base>

<script>
  // Highlight the section being read. A heading counts as current once it
  // has scrolled into the top third of the viewport, and stays current until
  // the next one does.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[data-toc]'));
  const targets = links
    .map((a) => document.getElementById(a.dataset.toc ?? ''))
    .filter((el): el is HTMLElement => el !== null);
  if (links.length && 'IntersectionObserver' in window) {
    const setActive = (id: string) =>
      links.forEach((a) => a.classList.toggle('is-active', a.dataset.toc === id));
    const observer = new IntersectionObserver(
      () => {
        const passed = targets.filter((t) => t.getBoundingClientRect().top < window.innerHeight / 3);
        const current = passed.at(-1) ?? targets[0];
        if (current) setActive(current.id);
      },
      { rootMargin: '0px 0px -66% 0px', threshold: [0, 1] },
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>

<style>
  .toc {
    display: none;
  }
  /* The article is 680px and centered; the left gutter only has room for a
     table of contents on wide screens. Marginals use the right gutter. */
  @media (min-width: 1240px) {
    .toc {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      position: fixed;
      top: 7rem;
      left: calc(50vw - 340px - 230px);
      width: 190px;
      max-height: calc(100vh - 9rem);
      overflow-y: auto;
      font-family: var(--font-jetbrains);
      font-size: 0.7rem;
      letter-spacing: 0.04em;
    }
    .toc a {
      color: var(--text-muted);
      text-decoration: none;
      border-left: 1px solid var(--border);
      padding: 0.2rem 0 0.2rem 0.8rem;
      line-height: 1.4;
      transition:
        color 0.2s ease,
        border-color 0.2s ease;
    }
    .toc a:hover,
    .toc a.is-active {
      color: var(--accent);
      border-left-color: var(--accent);
    }
  }
  .prose :global(h3) {
    scroll-margin-top: 2rem;
  }
  .essay {
    max-width: 680px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }
  header h1 {
    font-family: var(--font-crimson);
    font-size: 2.6rem;
    font-weight: 500;
    margin: 0 0 0.75rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .meta {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    color: var(--text-dim);
    font-family: var(--font-jetbrains);
    font-size: 0.75rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }
  .prose :global(p) {
    margin: 1.2em 0;
  }
  .prose :global(a) {
    color: var(--text);
    border-bottom: 1px solid rgba(232, 168, 56, 0.5);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .prose :global(a:hover) {
    color: var(--accent);
  }
  .prose :global(h2) {
    font-family: var(--font-crimson);
    font-size: 1.45rem;
    margin: 2.5em 0 0.5em;
    font-weight: 500;
  }
  .prose :global(code) {
    font-family: var(--font-jetbrains);
    font-size: 0.88em;
    background: var(--bg-card);
    padding: 0.08em 0.35em;
    border-radius: 3px;
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--border);
    margin: 1.5em 0;
    padding: 0 0 0 1.2em;
    color: var(--text-dim);
    font-style: italic;
  }

  /* First content with code blocks landed 2026-09; these rules exist so the
     shiki output stops looking like a pasted screenshot. */
  .prose :global(h3) {
    font-family: var(--font-crimson);
    font-size: 1.15rem;
    margin: 2em 0 0.4em;
    font-weight: 600;
    color: var(--text-dim);
  }
  .prose :global(h4) {
    font-family: var(--font-jetbrains);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    margin: 2.2em 0 0.3em;
  }
  .prose :global(pre) {
    background: var(--bg-card) !important;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1rem 1.1rem;
    margin: 1.6em 0;
    overflow-x: auto;
    font-size: 0.78rem;
    line-height: 1.6;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 3em auto;
    width: 40%;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
  }
  .prose :global(li) {
    margin: 0.5em 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.8em 0;
    font-family: var(--font-jetbrains);
    font-size: 0.74rem;
  }
  .prose :global(th),
  .prose :global(td) {
    border-bottom: 1px solid var(--border);
    padding: 0.45em 0.6em;
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    color: var(--text-dim);
    font-weight: 500;
  }
  /* Numbers never break across lines; a cell reading "4.7¢" over "(67%)"
     next to one that fits makes a table look ragged. Text columns wrap. */
  .prose :global(td[style*='right']) {
    white-space: nowrap;
  }
  /* Phones: tighter type, and any table that still doesn't fit scrolls inside
     its own box rather than pushing the whole page sideways. */
  @media (max-width: 600px) {
    .prose :global(table) {
      display: block;
      overflow-x: auto;
      font-size: 0.64rem;
    }
    .prose :global(th),
    .prose :global(td) {
      padding: 0.4em 0.35em;
    }
    .prose :global(td:first-child) {
      min-width: 6.5em;
    }
  }
  .tldr {
    margin: -1.6rem 0 2.8rem;
    padding: 0.9rem 1.1rem;
    border-left: 2px solid var(--accent-dim);
    background: var(--bg-card);
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .tldr-label {
    display: block;
    font-family: var(--font-jetbrains);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }
  /* KaTeX sets math at 1.21em, tuned for Computer Modern next to Computer
     Modern. Against Crimson Pro that reads a size too large. */
  .prose :global(.katex) {
    font-size: 1.04em;
  }
  .prose :global(.katex-display) {
    margin: 1.4em 0;
  }
  /* Crimson Pro sets old-style figures; KaTeX's are lining, so 0.1316 beside
     a = 0.45 looked like two sizes of number. Posts with math get lining
     figures throughout; posts without keep the old-style ones. */
  .prose:has(:global(.katex)) {
    font-variant-numeric: lining-nums;
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--text);
  }
</style>
