---
import { getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Backlinks from '@/components/Backlinks.astro';
import App from '@/components/care-for-an-esper/App';

const entry = await getEntry('essays', 'care-for-an-esper');
if (!entry) throw new Error('care-for-an-esper entry missing');
---

<Base title={entry.data.title} description={entry.data.description}>
  <App client:only="react" />
  <section class="cfe-chrome">
    <Backlinks slug={entry.id} />
  </section>
</Base>

<style is:global>
  /* The walkthrough runs in a notepad register — light cream bg, black ink.
     Override the site's dark warm body so the sticky ATB rail and gate hints
     read against the right substrate. Backlinks chrome stays site-default. */
  body:has(.cfe-root) {
    background: #f4ecd8;
  }
</style>

<style>
  .cfe-chrome {
    max-width: 680px;
    margin: 3rem auto 0;
    padding: 0 1.5rem 4rem;
    background: #f4ecd8;
  }
</style>
